{
  "name": "tool__chat_llm",
  "description": "Invoke the configured LLM for the current actor using chat-style messages. Use for one-shot analysis/summarization, or short internal deliberation. Returns the model's text response.",
  "parameters": {
    "type": "object",
    "properties": {
      "system": {
        "type": "string",
        "description": "Optional system prompt"
      },
      "messages": {
        "type": "array",
        "description": "Chat messages in OpenAI format (role + content, optionally tool_calls / tool_call_id)",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "description": "Message role: system, user, assistant, or tool"
            },
            "content": {
              "type": "string",
              "description": "Message content"
            },
            "tool_calls": {
              "type": "array",
              "description": "Optional tool calls (assistant only)",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Tool call id"
                  },
                  "type": {
                    "type": "string",
                    "description": "Tool call type (usually 'function')"
                  },
                  "function": {
                    "type": "object",
                    "description": "Tool call function payload",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Tool name"
                      },
                      "arguments": {
                        "type": "string",
                        "description": "JSON-encoded arguments"
                      }
                    },
                    "required": ["name", "arguments"],
                    "additionalProperties": false
                  }
                },
                "required": ["id", "type", "function"],
                "additionalProperties": false
              }
            },
            "tool_call_id": {
              "type": "string",
              "description": "Tool call id this tool message responds to"
            }
          },
          "required": ["role"],
          "additionalProperties": false
        }
      },
      "temperature": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 2.0,
        "description": "Sampling temperature (default: model default)"
      },
      "max_tokens": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16000,
        "description": "Maximum tokens in response (default: 4096)"
      }
    },
    "required": ["messages"],
    "additionalProperties": false
  }
}
