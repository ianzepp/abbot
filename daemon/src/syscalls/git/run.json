{
  "name": "tool__git_run",
  "description": "Run a git command.",
  "parameters": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
        "description": "Git subcommand (e.g. \"status\", \"log\", \"clone\", \"diff\", \"add\")"
      },
      "args": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Arguments to pass to the git subcommand"
      },
      "cwd": {
        "type": "string",
        "description": "Optional working directory (VFS path)"
      }
    },
    "required": ["command"],
    "additionalProperties": false
  }
}
