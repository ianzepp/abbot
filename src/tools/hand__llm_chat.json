{
  "name": "hand__llm_chat",
  "description": "Make a one-shot LLM request to any configured model.",
  "parameters": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "description": "Model ID (e.g., 'anthropic/claude-sonnet-4-20250514' or 'openrouter/openai/gpt-5.2')"
      },
      "prompt": {
        "type": "string",
        "description": "The user prompt to send"
      },
      "system": {
        "type": "string",
        "description": "Optional system prompt"
      },
      "temperature": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 2.0,
        "description": "Sampling temperature (default: model default)"
      },
      "max_tokens": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16000,
        "description": "Maximum tokens in response (default: 4096)"
      }
    },
    "required": ["model", "prompt"],
    "additionalProperties": false
  }
}
